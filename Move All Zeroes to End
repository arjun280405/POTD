class Solution {
  public:
    void pushZerosToEnd(vector<int>& nums) {
        int n=nums.size();
        int index=0;
        for(int i=0;i<n;i++)
        {
            //non zero ko index element pe push kro
            if(nums[i]!=0)
            {
                nums[index]=nums[i];
                index++;
            }
        }
        while(index<n)
        {
            nums[index]=0;//jo remaining jagah hai waha par 0 daal do
            index++;
        }
    }
};
