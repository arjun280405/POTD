class Solution {
public:
    int concatenatedBinary(int n) {
        long res=0;
        int M=1e9+7;
        for(int i=1;i<=n;i++)
        {
            //first we check how many bit required for ith bit
            int digits=log2(i)+1;
            //result me jagah banao 

            res=((res<<digits)%M+i)%M;
        }
        return res;
    }
};
class Solution {
public:
    int M=1e9+7;
    int concatenatedBinary(int n) {
        long res=0;
        int digits=0;
        for(int i=1;i<=n;i++)
        {
            //means power of two mil gya to bit badh jayegi
           if((i&(i-1))==0)digits++;
            //result me jagah banao 
            res=((res<<digits)%M+i)%M;
        }
        return res;
    }
};
